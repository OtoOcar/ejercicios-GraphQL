{
  "compilerOptions": {
    "target": "ES2020",                          
    "module": "commonjs",                        
    "rootDir": "src",                            
    "outDir": "dist", 
    "lib": ["ES2020", "DOM"],  
    "removeComments": true,                         
    "strict": true,                              
    "esModuleInterop": true,                     
    "forceConsistentCasingInFileNames": true,    
    "skipLibCheck": true,                        
    "resolveJsonModule": true,                   
    "moduleResolution": "node",                  
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "noEmitOnError": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
